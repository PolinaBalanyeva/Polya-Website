---
import '../styles/global.css'; // ←Tailwind v4を読み込む

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" data-theme="nord"> 
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-wakaba-shine to-wakaba text-base-content/80 selection:bg-success/20">
		<slot />
	</body>
</html>